{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -File scripts/update-claude-md.ps1",
            "if": "Bash(git commit*)",
            "shell": "powershell",
            "timeout": 30,
            "statusMessage": "Mise à jour CLAUDE.md…",
            "async": true
          }
        ]
      }
    ],
    "PostCompact": []
  }
}
