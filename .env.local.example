# ─────────────────────────────────────────────────────────────────────────────
# Jarvis — Variables d'environnement (copier vers .env.local)
# ─────────────────────────────────────────────────────────────────────────────

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── SpatialReal AvatarKit (serveur) ──────────────────────────────────────────
# URL de base de l'API AvatarKit (défaut : https://api.spatialreal.com/v1)
AVATARKIT_API_URL=https://api.spatialreal.com/v1

# Clé API SpatialReal (dashboard : https://app.spatialreal.com)
AVATARKIT_API_KEY=sk-spatialreal-...

# ID de voix par défaut (optionnel — utilise la voix par défaut de l'avatar)
AVATARKIT_VOICE_ID=

# ── SpatialReal AvatarKit (client/public) ────────────────────────────────────
# Ces variables sont exposées au navigateur (préfixe NEXT_PUBLIC_)

# ID de l'avatar créé dans le dashboard SpatialReal
NEXT_PUBLIC_AVATARKIT_AVATAR_ID=avatar_xxxxxxxxxxxx

# Qualité de rendu : low | medium | high
NEXT_PUBLIC_AVATARKIT_QUALITY=medium

# Langue BCP-47 pour la synthèse vocale
NEXT_PUBLIC_AVATARKIT_LANGUAGE=fr-FR

# ID de voix public (optionnel)
NEXT_PUBLIC_AVATARKIT_VOICE_ID=

# ── Deepgram STT ──────────────────────────────────────────────────────────────
# Clé API Deepgram (https://console.deepgram.com)
DEEPGRAM_API_KEY=...

# ── ElevenLabs TTS (déprécié — remplacé par AvatarKit WebRTC) ───────────────
# Conserver pour fallback en cas d'indisponibilité AvatarKit
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
