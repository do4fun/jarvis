# ─────────────────────────────────────────────────────────────────────────────
# Jarvis — Variables d'environnement (copier vers .env.local)
# ─────────────────────────────────────────────────────────────────────────────

# ── Anthropic Claude (text chat fallback) ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── LiveKit Cloud ──────────────────────────────────────────────────────────────
# Créer un projet sur https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Deepgram STT ──────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key

# ── LLM pour l'agent Python (OpenAI ou compatible) ────────────────────────────
LLM_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=  # laisser vide pour OpenAI par défaut

# ── Cartesia TTS ───────────────────────────────────────────────────────────────
CARTESIA_API_KEY=your_cartesia_api_key

# ── SpatialReal AvatarKit ─────────────────────────────────────────────────────
SPATIALREAL_APP_ID=your_spatialreal_app_id
SPATIALREAL_API_KEY=your_spatialreal_api_key

# Exposées au navigateur (SDK @spatialwalk/avatarkit)
NEXT_PUBLIC_SPATIALREAL_APP_ID=your_spatialreal_app_id
NEXT_PUBLIC_AVATARKIT_AVATAR_ID=your_avatar_id

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Jarvis
